APP_NAME=Łowiska
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:11000
# Read via config('services.cso.key') — GUS (CSO) registry API key.
CSO_KEY=abcde12345abcde12345
# Read via config('app.admin_email') — shown to users who need to contact an administrator.
ADMIN_EMAIL=admin@example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Flare (flareapp.io) — error tracking and performance monitoring.
# Leave FLARE_KEY empty to disable reporting entirely.
# project key: flareapp.io -> project -> Settings -> API tokens
FLARE_KEY=
FLARE_REPORT=true
FLARE_TRACE=true
FLARE_SAMPLER_RATE=1.0
FLARE_LOG=false

# Baza działa w kontenerze `mysql` (docker-compose.yml), na hoście pod portem 6306.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lowiska
DB_USERNAME=lowiska
DB_PASSWORD=lowiska

SESSION_DRIVER=database
# ⚠️ Na środowisku wystawionym przez HTTPS ustaw `true`. `null` NIE oznacza
# „wykryj automatycznie" — ciasteczko sesji leci wtedy bez flagi `Secure`,
# a zaufane proxy tego nie naprawia (flaga czytana jest z konfiguracji,
# nie ze schematu żądania).
SESSION_SECURE_COOKIE=false
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Uploady lokalnie idą na dysk `public` (storage/app/public, symlink public/storage), a oryginały
# zdjęć i pliki tymczasowe uploadu — na prywatny `local` (storage/app/private).
# Na Cloud Run (staging, prod) storage jest efemeryczny per instancja — tam włączają się dwa
# buckety GCS fundamentu (publiczny i prywatny), patrz docs/operations/obraz-produkcyjny.md §9:
#   FILESYSTEM_DISK=gcs-private
#   FILAMENT_FILESYSTEM_DISK=gcs
#   MEDIA_DISK=gcs-private
#   MEDIA_CONVERSIONS_DISK=gcs
#   LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=gcs-private
#   GOOGLE_CLOUD_STORAGE_BUCKET=esurf-foundation-lowiska-<env>-storage
#   GOOGLE_CLOUD_STORAGE_PRIVATE_BUCKET=esurf-foundation-lowiska-<env>-private
# Lokalnie zmienne bucketów nie są potrzebne — buckety nie istnieją na tym środowisku.
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Poczta deweloperska idzie do Mailpita (docker-compose.yml).
# Skrzynka: http://localhost:11025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Bez tego klucza podgląd mapy w formularzu łowiska pokazuje sam adres,
# bez osadzonej mapy (patrz resources/views/filament/forms/map-preview.blade.php).
GOOGLE_MAPS_API_KEY=

# Statystyki portalu — puste lokalnie i na stagingu; produkcji podaje je deploy.yml (zadanie 031).
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=
