# FrankenPHP w trybie classic (ADR-002).
#
# {$SERVER_NAME} wypełnia prod-entrypoint na podstawie $PORT wstrzykiwanego
# przez Cloud Run — nasłuch nie może być wpisany na sztywno.

{
	frankenphp
	auto_https off
	admin off
}

{$SERVER_NAME} {
	root /app/public
	encode zstd br gzip

	# Kontrola stanu obsługiwana przez trasę /up Laravela
	# (bootstrap/app.php → health: '/up').

	# Basic auth bramkujący staging. BASIC_AUTH_SNIPPET jest ustawiany TYLKO w
	# deployu staging (deploy.yml); bez env (prod, dev/native) importuje pusty
	# noop.caddy — brak auth, zero zmiany zachowania. /up wyłączone spod bramki
	# wewnątrz basic-auth.caddy (health check Cloud Run).
	import {$BASIC_AUTH_SNIPPET:/etc/caddy/snippets/noop.caddy}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@static {
		path /build/* /favicon.ico /robots.txt
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	php_server
}
